{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 4,
    "margin-top": 2,
    "margin-left": 3,
    "margin-right": 3,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "pulseaudio", "backlight", "power-profiles-daemon", "battery", "custom/displays", "custom/power"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{value}"
    },

    "sway/mode": {
        "format": "{}"
    },

    "sway/window": {
        "max-length": 40
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂰 {icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc}, {volume}%",
        "scroll-step": 5,
        "on-click": "pavucontrol -t 3",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "backlight": {
        "format": "󰃟 {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "format-icons": {
            "default": "󰓅",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        }
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󱘖 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}, {power}W"
    },

    "custom/displays": {
        "format": "󰍹",
        "tooltip-format": "Displays / eye saver",
        "on-click": "~/.config/sway/scripts/display-menu"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "on-click": "~/.config/sway/scripts/power-menu"
    }
}
