# Output profiles. Matching is by "make model serial", never by connector
# name (HDMI-A-1 / HDMI-A-3 change between boots). Specific profiles first,
# generic fallbacks last. Find descriptions with: swaymsg -t get_outputs

# eDP-1 is the built-in panel; its name is stable but its make string differs
# between GNOME and Sway, so it is matched by name. External monitors are
# matched by description.
# Laptop panel + Acer XV272K V5 (4K). Kanshi rejects a whole profile if a mode
# is missing, and the 160Hz mode is not always offered right after hotplug or an
# input switch, so the mode is not in the profile. dock-apply sets 160Hz after
# the profile applies and retries until sway confirms it (see scripts/dock-apply).
profile docked {
    output eDP-1 mode 3200x2000@165Hz position 0,0 scale 2
    output "Acer Technologies XV272K V5 153102E3F4201" position 1600,0 scale 1.5
    exec ~/.config/sway/scripts/dock-apply
}

# Laptop panel alone
profile mobile {
    output eDP-1 enable mode 3200x2000@165Hz position 0,0 scale 2
}

# Any other monitor: keep the laptop panel, enable the newcomer at its
# preferred mode and let Sway place it to the right. No scale is set here, so a
# 4K panel would come up at scale 1.
profile unknown-external {
    output eDP-1 enable mode 3200x2000@165Hz position 0,0 scale 2
    output * enable
}
